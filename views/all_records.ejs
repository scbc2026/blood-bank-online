<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Donation Records</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, sans-serif; padding: 20px; background: #f8f9fa; margin: 0; }
        
        .top-bar { background: #343a40; color: white; padding: 15px 20px; font-size: 18px; font-weight: bold; border-radius: 5px 5px 0 0; display: flex; justify-content: space-between; align-items: center;}
        .top-bar a { color: #fff; text-decoration: none; font-size: 14px; background: #dc3545; padding: 5px 15px; border-radius: 3px; }

        .container { background: white; padding: 20px; border-radius: 0 0 5px 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        
        .controls-row { display: flex; gap: 15px; margin-bottom: 20px; align-items: center; }
        .search-box { padding: 10px; width: 300px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
        .filter-select { padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; font-weight: bold; color: #d9534f; cursor: pointer; }

        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { border-bottom: 1px solid #ddd; padding: 12px 10px; text-align: left; }
        th { background-color: #17a2b8; color: white; white-space: nowrap; }
        tr:hover { background-color: #f1f1f1; }
        
        .bg-badge { background: #d9534f; color: white; padding: 3px 8px; border-radius: 12px; font-weight: bold; font-size: 12px; }
        
        .action-btn { padding: 5px 10px; border: none; border-radius: 3px; cursor: pointer; color: white; text-decoration: none; font-size: 12px; margin-right: 5px; display: inline-block; }
        .btn-view { background-color: #0275d8; } 
        .btn-edit { background-color: #f0ad4e; }
        .btn-delete { background-color: #d9534f; }

        /* 🖼️ MODAL (POPUP) STYLING */
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;
        }
        .modal-box {
            background: white; width: 500px; padding: 25px; border-radius: 8px; 
            box-shadow: 0 5px 15px rgba(0,0,0,0.3); position: relative; max-height: 90vh; overflow-y: auto;
        }
        .modal-header { font-size: 20px; font-weight: bold; color: #17a2b8; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 15px; }
        .close-btn { position: absolute; top: 15px; right: 20px; font-size: 24px; cursor: pointer; color: #888; border: none; background: none; }
        .close-btn:hover { color: red; }
        
        .detail-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px dashed #eee; font-size: 14px; }
        .detail-label { font-weight: bold; color: #555; }
        .detail-value { color: #222; text-align: right; font-weight: 500; }

        /* 📜 HISTORY TABLE IN MODAL */
        .history-section { margin-top: 20px; background: #fdfdfd; border: 1px solid #ddd; border-radius: 5px; padding: 10px; }
        .history-title { font-weight: bold; color: #d9534f; margin-bottom: 10px; font-size: 15px; border-bottom: 2px solid #d9534f; padding-bottom: 5px; display: inline-block;}
        .history-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .history-table th { background: #eee; color: #333; padding: 6px; border: 1px solid #ccc; text-align: center;}
        .history-table td { padding: 6px; border: 1px solid #ccc; text-align: center; }
    </style>
</head>
<body>

    <div class="top-bar">
        <span>📄 All Donation Records</span>
        <a href="/admin-panel">⬅ Back to Dashboard</a>
    </div>

    <div class="container">
        
        <div class="controls-row">
            <input type="text" id="searchInput" class="search-box" onkeyup="filterTable()" placeholder="Search by Name or Mobile...">
            
            <select id="bgFilter" class="filter-select" onchange="filterTable()">
                <option value="All">🩸 All Blood Groups</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
            </select>
        </div>

        <table id="recordsTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Donor Name</th>
                    <th>Mobile</th>
                    <th>Bag No</th>
                    <th>Blood Group</th>
                    <th>TTI Result</th>
                    <th>Action</th>
                    <th>Enter By</th>
                </tr>
            </thead>
            <tbody>
                <% if(donations && donations.length > 0) { %>
                    <% donations.forEach(function(don) { %>
                        <% let isSafe = (don.hiv === 'Non-Reactive' && don.hbsag === 'Non-Reactive' && don.hcv === 'Non-Reactive' && don.syphilis === 'Non-Reactive'); %>
                        <tr>
                            <td><%= don.donationDate ? new Date(don.donationDate).toDateString() : 'N/A' %></td>
                            <td><%= don.donorId ? don.donorId.name : 'Unknown' %></td>
                            <td><%= don.donorId ? don.donorId.mobile : 'N/A' %></td>
                            <td><%= don.bagNumber %></td>
                            <td><span class="bg-badge"><%= don.donorId ? don.donorId.bloodGroup : 'N/A' %></span></td>
                            <td style="color: <%= isSafe ? 'green' : 'red' %>; font-weight: bold;">
                                <%= isSafe ? 'Safe' : 'Reactive' %>
                            </td>
                            <td style="white-space: nowrap;">
                                
                                <button class="action-btn btn-view" onclick="openModal(this)"
                                    data-name="<%= don.donorId ? don.donorId.name : 'N/A' %>"
                                    data-fname="<%= don.donorId ? don.donorId.fatherName : 'N/A' %>"
                                    data-mobile="<%= don.donorId ? don.donorId.mobile : 'N/A' %>"
                                    data-aadhaar="<%= don.donorId ? don.donorId.aadhaar : 'N/A' %>"
                                    data-age="<%= don.donorId ? don.donorId.age : 'N/A' %>"
                                    data-gender="<%= don.donorId ? don.donorId.gender : 'N/A' %>"
                                    data-bg="<%= don.donorId ? don.donorId.bloodGroup : 'N/A' %>"
                                    data-address="<%= don.donorId ? don.donorId.address : 'N/A' %>"
                                    data-date="<%= don.donationDate ? new Date(don.donationDate).toDateString() : 'N/A' %>"
                                    data-bag="<%= don.bagNumber %>"
                                    data-type="<%= don.donationType || 'Voluntary' %>"
                                    data-safe="<%= isSafe ? 'Safe ✅' : 'Reactive ❌' %>">
                                    View 👁️
                                </button>
                                
                                <a href="/edit-donation/<%= don._id %>" class="action-btn btn-edit">Edit ✏️</a>
                                <a href="/delete-donation/<%= don._id %>" class="action-btn btn-delete" onclick="return confirm('Are you sure?')">Delete 🗑️</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" style="text-align: center; padding: 20px;">No records found.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div id="donorModal" class="modal-overlay">
        <div class="modal-box">
            <button class="close-btn" onclick="closeModal()">&times;</button>
            <div class="modal-header">🩸 Full Donor Profile</div>
            
            <div class="detail-row"><span class="detail-label">Donor Name:</span> <span class="detail-value" id="m-name"></span></div>
            <div class="detail-row"><span class="detail-label">Father's Name:</span> <span class="detail-value" id="m-fname"></span></div>
            <div class="detail-row"><span class="detail-label">Mobile:</span> <span class="detail-value" id="m-mobile"></span></div>
            <div class="detail-row"><span class="detail-label">Aadhaar No:</span> <span class="detail-value" id="m-aadhaar"></span></div>
            <div class="detail-row"><span class="detail-label">Age & Gender:</span> <span class="detail-value" id="m-age-gender"></span></div>
            <div class="detail-row"><span class="detail-label">Blood Group:</span> <span class="detail-value" style="color:red; font-size:16px;" id="m-bg"></span></div>
            <div class="detail-row"><span class="detail-label">Address:</span> <span class="detail-value" id="m-address"></span></div>
            
            <div class="history-section">
                <div class="history-title">📅 Past Donation History (<span id="m-count">0</span> Times)</div>
                <div id="m-history-table-container">
                    </div>
            </div>

        </div>
    </div>

    <script>
        // 1. Search & Filter Logic
        function filterTable() {
            let searchText = document.getElementById("searchInput").value.toLowerCase();
            let bgFilter = document.getElementById("bgFilter").value;
            let tr = document.getElementById("recordsTable").getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                let tdName = tr[i].getElementsByTagName("td")[1];   
                let tdMobile = tr[i].getElementsByTagName("td")[2]; 
                let tdBlood = tr[i].getElementsByTagName("td")[4];  
                
                if (tdName && tdMobile && tdBlood) {
                    let nameText = (tdName.textContent || tdName.innerText).toLowerCase();
                    let mobileText = (tdMobile.textContent || tdMobile.innerText).toLowerCase();
                    let bloodText = (tdBlood.textContent || tdBlood.innerText).trim();
                    
                    let matchesSearch = nameText.includes(searchText) || mobileText.includes(searchText);
                    let matchesBg = (bgFilter === "All" || bloodText === bgFilter);

                    tr[i].style.display = (matchesSearch && matchesBg) ? "" : "none";
                }
            }
        }

        // 2. Modal & History Logic
        function openModal(btn) {
            let mobile = btn.getAttribute("data-mobile");

            // Basic Details Set karo
            document.getElementById("m-name").innerText = btn.getAttribute("data-name");
            document.getElementById("m-fname").innerText = btn.getAttribute("data-fname");
            document.getElementById("m-mobile").innerText = mobile;
            document.getElementById("m-aadhaar").innerText = btn.getAttribute("data-aadhaar");
            document.getElementById("m-age-gender").innerText = btn.getAttribute("data-age") + " Yrs, " + btn.getAttribute("data-gender");
            document.getElementById("m-bg").innerText = btn.getAttribute("data-bg");
            document.getElementById("m-address").innerText = btn.getAttribute("data-address");

            // 🔍 History Generator (Mobile Number se dhoondo)
            let allBtns = document.querySelectorAll('.btn-view');
            let historyHtml = '<table class="history-table"><tr><th>Date</th><th>Bag No</th><th>Type</th><th>Result</th></tr>';
            let donationCount = 0;

            allBtns.forEach(function(b) {
                // Agar button ka mobile number click kiye gaye donor se match karta hai
                if (mobile !== 'N/A' && b.getAttribute('data-mobile') === mobile) {
                    historyHtml += '<tr>';
                    historyHtml += '<td>' + b.getAttribute('data-date') + '</td>';
                    historyHtml += '<td>' + b.getAttribute('data-bag') + '</td>';
                    historyHtml += '<td>' + b.getAttribute('data-type') + '</td>';
                    
                    let safeStatus = b.getAttribute('data-safe');
                    let color = safeStatus.includes('Safe') ? 'green' : 'red';
                    historyHtml += '<td style="color:' + color + '; font-weight:bold;">' + safeStatus + '</td>';
                    
                    historyHtml += '</tr>';
                    donationCount++;
                }
            });
            historyHtml += '</table>';

            // Agar galti se kisi ka mobile nahi hai, to kam se kam current record dikha do
            if(donationCount === 0) {
                historyHtml = '<p style="text-align:center; color:#777; margin:5px;">History not available.</p>';
                donationCount = 1;
            }

            // History aur Count ko Modal me dal do
            document.getElementById("m-history-table-container").innerHTML = historyHtml;
            document.getElementById("m-count").innerText = donationCount;

            // Modal dikhao
            document.getElementById("donorModal").style.display = "flex";
        }

        function closeModal() {
            document.getElementById("donorModal").style.display = "none";
        }
    </script>

</body>
</html>
