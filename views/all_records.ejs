<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Donation Records</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, sans-serif; padding: 20px; background: #f8f9fa; margin: 0; }
        
        /* Top Navigation Bar */
        .top-bar { background: #343a40; color: white; padding: 15px 20px; font-size: 18px; font-weight: bold; border-radius: 5px 5px 0 0; display: flex; justify-content: space-between; align-items: center;}
        .top-bar a { color: #fff; text-decoration: none; font-size: 14px; background: #dc3545; padding: 5px 15px; border-radius: 3px; }

        .container { background: white; padding: 20px; border-radius: 0 0 5px 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        
        /* Filter Controls */
        .controls-row { display: flex; gap: 15px; margin-bottom: 20px; align-items: center; }
        .search-box { padding: 10px; width: 300px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
        .filter-select { padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; font-weight: bold; color: #d9534f; cursor: pointer; }

        /* Table Styling */
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { border-bottom: 1px solid #ddd; padding: 12px 10px; text-align: left; }
        
        /* Blue Header matching your photo */
        th { background-color: #17a2b8; color: white; white-space: nowrap; }
        tr:hover { background-color: #f1f1f1; }
        
        /* Badges & Buttons */
        .bg-badge { background: #d9534f; color: white; padding: 3px 8px; border-radius: 12px; font-weight: bold; font-size: 12px; }
        .action-btn { padding: 5px 10px; border: none; border-radius: 3px; cursor: pointer; color: white; text-decoration: none; font-size: 12px; margin-right: 5px; }
        .btn-edit { background-color: #f0ad4e; }
        .btn-delete { background-color: #d9534f; }
    </style>
</head>
<body>

    <div class="top-bar">
        <span>📄 All Donation Records</span>
        <a href="/admin-panel">⬅ Back to Dashboard</a>
    </div>

    <div class="container">
        
        <div class="controls-row">
            <input type="text" id="searchInput" class="search-box" onkeyup="filterTable()" placeholder="Search by Name or Mobile...">
            
            <select id="bgFilter" class="filter-select" onchange="filterTable()">
                <option value="All">🩸 All Blood Groups</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
            </select>
        </div>

        <table id="recordsTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Donor Name</th>
                    <th>Mobile</th>
                    <th>Bag No</th>
                    <th>Blood Group</th> <th>TTI Result</th>
                    <th>Enter By</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if(donations && donations.length > 0) { %>
                    <% donations.forEach(function(don) { %>
                        <tr>
                            <td><%= don.donationDate ? new Date(don.donationDate).toDateString() : 'N/A' %></td>
                            
                            <td><%= don.donorId ? don.donorId.name : 'Unknown' %></td>
                            <td><%= don.donorId ? don.donorId.mobile : 'N/A' %></td>
                            
                            <td><%= don.bagNumber %></td>
                            
                            <td>
                                <span class="bg-badge"><%= don.donorId ? don.donorId.bloodGroup : 'N/A' %></span>
                            </td>
                            
                            <% 
                               let isSafe = (don.hiv === 'Non-Reactive' && don.hbsag === 'Non-Reactive' && don.hcv === 'Non-Reactive' && don.syphilis === 'Non-Reactive');
                            %>
                            <td style="color: <%= isSafe ? 'green' : 'red' %>; font-weight: bold;">
                                <%= isSafe ? 'Safe' : 'Reactive' %>
                            </td>
                            
                            <td><%= don.enteredBy || 'Admin' %></td>
                            
                            <td>
                                <a href="/edit-donation/<%= don._id %>" class="action-btn btn-edit">Edit ✏️</a>
                                <a href="/delete-donation/<%= don._id %>" class="action-btn btn-delete" onclick="return confirm('Are you sure you want to delete this record?')">Delete 🗑️</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 20px; color: #777;">No records found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script>
        function filterTable() {
            // Text box aur Dropdown dono ki value uthao
            let searchText = document.getElementById("searchInput").value.toLowerCase();
            let bgFilter = document.getElementById("bgFilter").value;
            
            let table = document.getElementById("recordsTable");
            let tr = table.getElementsByTagName("tr");

            // Loop lagao (Row 1 se shuru, 0 par Heading hai)
            for (let i = 1; i < tr.length; i++) {
                let tdName = tr[i].getElementsByTagName("td")[1];   // Name Column
                let tdMobile = tr[i].getElementsByTagName("td")[2]; // Mobile Column
                let tdBlood = tr[i].getElementsByTagName("td")[4];  // Blood Group Column
                
                if (tdName && tdMobile && tdBlood) {
                    let nameText = tdName.textContent || tdName.innerText;
                    let mobileText = tdMobile.textContent || tdMobile.innerText;
                    let bloodText = tdBlood.textContent || tdBlood.innerText;
                    
                    nameText = nameText.toLowerCase();
                    mobileText = mobileText.toLowerCase();
                    bloodText = bloodText.trim();

                    // Check: Kya text search match ho raha hai?
                    let matchesSearch = nameText.includes(searchText) || mobileText.includes(searchText);
                    
                    // Check: Kya blood group filter match ho raha hai?
                    let matchesBg = (bgFilter === "All" || bloodText === bgFilter);

                    // Agar dono shartein puri hoti hain, to dikhao, warna chupao
                    if (matchesSearch && matchesBg) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>

</body>
</html>
